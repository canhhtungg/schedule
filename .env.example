# Cổng Express (Vite dev proxy mặc định trỏ tới 3000)
PORT=3000

# Giới hạn riêng cho từng request tới QLĐT
QLDT_TIMEOUT_MS=12000
QLDT_MAX_BODY_BYTES=8388608

# Web Push + Upstash QStash (để trống trong file mẫu; không commit giá trị thật)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
NOTIFICATION_PAYLOAD_KEY=
APP_ORIGIN=http://localhost:5173

# Khi chạy production dùng: NODE_ENV=production npm start
